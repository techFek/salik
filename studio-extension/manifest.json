{
  "manifest_version": 3,
  "name": "Salik Studio",
  "version": "1.0.0",
  "description": "Salik Studio in Chrome's side panel: time and test Salik filters on the video playing in the tab next to it (Disney+, Netflix, …).",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.disneyplus.com/*",
    "https://disneyplus.com/*",
    "https://*.netflix.com/*",
    "https://netflix.com/*",
    "https://*.yango.com/*",
    "https://yango.com/*",
    "https://*.osnplus.com/*",
    "https://osnplus.com/*",
    "https://*.primevideo.com/*",
    "https://primevideo.com/*",
    "https://*.amazon.com/*",
    "https://amazon.com/*",
    "https://*.amazon.eg/*",
    "https://amazon.eg/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.starzplay.com/*",
    "https://starzplay.com/*",
    "https://*.jawwy.tv/*",
    "https://jawwy.tv/*",
    "https://*.stctv.com/*",
    "https://stctv.com/*",
    "https://*.watchit.com/*",
    "https://watchit.com/*",
    "https://*.dailymotion.com/*",
    "https://dailymotion.com/*",
    "https://dai.ly/*",
    "https://*.tod.tv/*",
    "https://tod.tv/*",
    "https://*.bein.com/*",
    "https://bein.com/*",
    "https://*.beinconnect.com/*",
    "https://beinconnect.com/*",
    "*://*.shahid.mbc.net/*",
    "*://shahid.mbc.net/*",
    "https://tv.apple.com/*",
    "https://*.stremio.com/*",
    "https://stremio.com/*",
    "https://*.strem.fun/*",
    "https://strem.fun/*",
    "https://opensubtitles-v3.strem.io/*",
    "https://*.strem.io/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Salik Studio",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "128": "images/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "studio.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://*.netflix.com/*",
        "https://netflix.com/*",
        "https://*.yango.com/*",
        "https://yango.com/*",
        "https://play.yango.com/*",
        "*://*.shahid.mbc.net/*",
        "*://shahid.mbc.net/*",
        "https://*.osnplus.com/*",
        "https://osnplus.com/*",
        "https://*.primevideo.com/*",
        "https://primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://amazon.com/gp/video/*",
        "https://*.amazon.com/v/*",
        "https://amazon.com/v/*",
        "https://*.amazon.eg/gp/video/*",
        "https://amazon.eg/gp/video/*",
        "https://*.amazon.eg/v/*",
        "https://amazon.eg/v/*",
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://youtube.com/shorts/*",
        "https://*.starzplay.com/*",
        "https://starzplay.com/*",
        "https://*.jawwy.tv/*",
        "https://jawwy.tv/*",
        "https://*.stctv.com/*",
        "https://stctv.com/*",
        "https://*.watchit.com/*",
        "https://watchit.com/*",
        "https://*.dailymotion.com/*",
        "https://dailymotion.com/*",
        "https://dai.ly/*",
        "https://*.tod.tv/*",
        "https://tod.tv/*",
        "https://*.bein.com/*",
        "https://bein.com/*",
        "https://*.beinconnect.com/*",
        "https://beinconnect.com/*",
        "https://tv.apple.com/*",
        "https://*.stremio.com/*",
        "https://stremio.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://*.netflix.com/*",
        "https://netflix.com/*",
        "https://*.yango.com/*",
        "https://yango.com/*",
        "https://play.yango.com/*",
        "*://*.shahid.mbc.net/*",
        "*://shahid.mbc.net/*",
        "https://*.osnplus.com/*",
        "https://osnplus.com/*",
        "https://*.primevideo.com/*",
        "https://primevideo.com/*",
        "https://*.amazon.com/gp/video/*",
        "https://amazon.com/gp/video/*",
        "https://*.amazon.com/v/*",
        "https://amazon.com/v/*",
        "https://*.amazon.eg/gp/video/*",
        "https://amazon.eg/gp/video/*",
        "https://*.amazon.eg/v/*",
        "https://amazon.eg/v/*",
        "https://www.youtube.com/watch*",
        "https://youtube.com/watch*",
        "https://www.youtube.com/shorts/*",
        "https://youtube.com/shorts/*",
        "https://*.starzplay.com/*",
        "https://starzplay.com/*",
        "https://*.jawwy.tv/*",
        "https://jawwy.tv/*",
        "https://*.stctv.com/*",
        "https://stctv.com/*",
        "https://*.watchit.com/*",
        "https://watchit.com/*",
        "https://*.dailymotion.com/*",
        "https://dailymotion.com/*",
        "https://dai.ly/*",
        "https://*.tod.tv/*",
        "https://tod.tv/*",
        "https://*.bein.com/*",
        "https://bein.com/*",
        "https://*.beinconnect.com/*",
        "https://beinconnect.com/*",
        "https://tv.apple.com/*",
        "https://*.stremio.com/*",
        "https://stremio.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "128": "images/icon128.png"
  }
}